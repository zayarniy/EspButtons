<Window x:Class="GuessMelody.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экран игроков"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{Binding BackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Key="F11" Command="{Binding ToggleFullscreenCommand}"/>
    </Window.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <TextBlock Text="{Binding GameTitle}"
                       FontSize="44" FontWeight="Bold"
                       Foreground="{Binding TextBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding RoundText}"
                       FontSize="26"
                       Foreground="{Binding AccentBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,16"/>
        </StackPanel>

        <!-- Категории -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="CatBorder"
                    Margin="6" Padding="12" CornerRadius="10"
                    BorderBrush="{Binding DataContext.AccentBrush,
                                  RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderThickness="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="#66FFD166"/>
                                        <Setter Property="BorderThickness" Value="3"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBlinking}" Value="True">
                                        <Setter Property="Background" Value="#FFD166"/>
                                        <Setter Property="BorderThickness" Value="4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CatScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border.RenderTransformOrigin>
                            <Point X="0.5" Y="0.5"/>
                        </Border.RenderTransformOrigin>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                               Foreground="{Binding DataContext.TextBrush,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="{Binding DataContext.CategoryFontSize,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CountText}"
                               Foreground="{Binding DataContext.AccentBrush,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="{Binding DataContext.NameFontSize,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                               TextAlignment="Center"
                               Margin="0,6,0,0"/>
                        </StackPanel>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                <!-- Не используется, оставлено на будущее -->
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsBlinking}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="CatBorder"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.4"
                                                 Duration="0:0:0.25"
                                                 AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="CatScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 From="1.0" To="1.05"
                                                 Duration="0:0:0.25"
                                                 AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="CatScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 From="1.0" To="1.05"
                                                 Duration="0:0:0.25"
                                                 AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CatBorder"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1.0" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="CatScale"
                                                 Storyboard.TargetProperty="ScaleX"
                                                 To="1.0" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="CatScale"
                                                 Storyboard.TargetProperty="ScaleY"
                                                 To="1.0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Прогресс фрагмента -->
        <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding StateText}"
                       FontSize="36" FontWeight="Bold"
                       Foreground="{Binding AccentBrush}"
                       HorizontalAlignment="Center"/>
            <ProgressBar Height="14" Margin="60,12,60,0"
                         Minimum="0" Maximum="1"
                         Value="{Binding TrackTotal, Mode=OneWay}"
                         Background="#22FFFFFF"
                         Foreground="{Binding AccentBrush}"/>
        </StackPanel>

        <!-- Ожидание/нажатие -->
        <TextBlock Grid.Row="3" Text="{Binding FirstPressedText, StringFormat='Нажал: {0}'}"
                   FontSize="28"
                   Foreground="{Binding TextBrush}"
                   HorizontalAlignment="Center"
                   Visibility="{Binding FirstPressedText, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"
                   Margin="0,0,0,8"/>

        <!-- Игроки -->
        <ItemsControl Grid.Row="4" ItemsSource="{Binding Teams}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="6" Padding="16" CornerRadius="12"
                            Background="#22FFFFFF"
                            MouseLeftButtonDown="TeamTile_LeftClick"
                            MouseRightButtonDown="TeamTile_RightClick"
                            Tag="{Binding Name}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                        <Setter Property="Background" Value="#FFD166"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{Binding DataContext.NameFontSize,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontWeight="Bold"
                                       Foreground="{Binding DataContext.TextBrush,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{Binding Score}"
                                       FontSize="{Binding DataContext.ScoreFontSize,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontWeight="Bold"
                                       Foreground="{Binding DataContext.AccentBrush,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
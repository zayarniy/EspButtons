<UserControl x:Class="GuessMelody.Views.Tabs.AnswerServerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="12">
        <TextBlock Text="Сервер ответов (HTTP)" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Порт:" VerticalAlignment="Center" Width="140"/>
            <TextBox Width="80" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInverter}}"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Заголовок страницы:" VerticalAlignment="Center" Width="140"/>
            <TextBox Width="300" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Текст/плейсхолдер:" VerticalAlignment="Center" Width="140"/>
            <TextBox Width="300" Text="{Binding Placeholder, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="▶ Запустить"  Command="{Binding StartCommand}" Padding="10,4" Margin="0,0,4,0"/>
            <Button Content="■ Остановить" Command="{Binding StopCommand}"  Padding="10,4" Margin="0,0,16,0"/>
            <Button Content="Открыть в браузере" Command="{Binding OpenBrowserCommand}" Padding="10,4"/>
        </StackPanel>

        <TextBlock Margin="0,12,0,0" Foreground="#666">
            <Run Text="URL:"/>
            <Run Text="{Binding Url, Mode=OneWay}"/>
        </TextBlock>

        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#888"
                   Text="Если сервер не запускается — возможно, порт занят или нужны права администратора. Запустите от имени администратора или выполните в консоли: netsh http add urlacl url=http://+:8080/ user=Everyone"/>
    </StackPanel>
</UserControl>
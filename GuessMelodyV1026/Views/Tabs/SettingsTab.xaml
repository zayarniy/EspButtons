<UserControl x:Class="GuessMelody.Views.Tabs.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="Настройки" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

            <GroupBox Header="Игра" Margin="0,0,0,8" Padding="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Игроков:" Width="200" VerticalAlignment="Center"/>
                        <TextBox Width="60" Text="{Binding PlayerCount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Раундов (0=∞):" Width="200" VerticalAlignment="Center"/>
                        <TextBox Width="60" Text="{Binding RoundCount, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Длительность фрагмента, сек:" Width="200" VerticalAlignment="Center"/>
                        <TextBox Width="60" Text="{Binding FragmentSec, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Старт по умолчанию, сек:" Width="200" VerticalAlignment="Center"/>
                        <TextBox Width="60" Text="{Binding DefaultStartSec, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <CheckBox Content="Начинать со случайного места"
                              IsChecked="{Binding RandomStart}" Margin="0,0,0,6"/>
                    <CheckBox Content="Обратный отсчёт на ответ"
                              IsChecked="{Binding CountdownOnAnswer}" Margin="0,0,0,6"/>
                    <CheckBox Content="Режим «Настройка» (очки не считаются)"
                              IsChecked="{Binding IsSetupMode}" Margin="0,0,0,6"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Звуки" Margin="0,0,0,8" Padding="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Громкость:" Width="200" VerticalAlignment="Center"/>
                        <Slider Width="200" Minimum="0" Maximum="100" Value="{Binding Volume}"/>
                        <TextBlock Text="{Binding Volume}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Тайминги" Margin="0,0,0,8" Padding="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Отсчёт перед музыкой, сек:" Width="200" VerticalAlignment="Center"/>
                        <TextBox Width="60" Text="{Binding CountdownBeforeSec, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Время на ответ, сек (0=∞):" Width="200" VerticalAlignment="Center"/>
                        <TextBox Width="60" Text="{Binding AnswerTimeoutSec, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Пауза между раундами, сек:" Width="200" VerticalAlignment="Center"/>
                        <TextBox Width="60" Text="{Binding PauseBetweenRoundsSec, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
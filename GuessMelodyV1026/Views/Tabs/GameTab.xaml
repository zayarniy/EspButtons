<UserControl x:Class="GuessMelody.Views.Tabs.GameTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="12">

        <TextBlock Text="Игра" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="UDP порт:" VerticalAlignment="Center" Width="120"/>
            <TextBox Width="80" Text="{Binding UdpPort, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInverter}}"
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="IP сервера:" VerticalAlignment="Center" Width="100" Margin="20,0,0,0"/>
            <TextBox Width="140" Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="▶ Запустить сервер"  Command="{Binding StartCommand}" Padding="10,4" Margin="0,0,4,0"/>
            <Button Content="■ Остановить сервер" Command="{Binding StopCommand}"  Padding="10,4" Margin="0,0,16,0"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#555"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="⤓ Загрузить игру" Command="{Binding LoadGameCommand}" Padding="10,4" Margin="0,0,4,0"/>
            <Button Content="⤒ Сохранить игру" Command="{Binding SaveGameCommand}" Padding="10,4" Margin="0,0,4,0"/>
            <Button Content="Сохранить как…"   Command="{Binding SaveGameAsCommand}" Padding="10,4"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Открыть экран игроков" Command="{Binding OpenPlayerCommand}" Padding="10,4" Margin="0,0,4,0"/>
            <Button Content="Открыть окно ведущего" Command="{Binding OpenHostCommand}"   Padding="10,4"/>
        </StackPanel>

        <Separator Margin="0,12"/>

        <TextBlock Text="Тестирование" FontWeight="Bold" Margin="0,0,0,6"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Нажатия:" VerticalAlignment="Center" Width="120"/>
            <Button Content="1" Command="{Binding TestPressCommand}" CommandParameter="1" Width="32" Margin="0,0,4,0"/>
            <Button Content="2" Command="{Binding TestPressCommand}" CommandParameter="2" Width="32" Margin="0,0,4,0"/>
            <Button Content="3" Command="{Binding TestPressCommand}" CommandParameter="3" Width="32" Margin="0,0,4,0"/>
            <Button Content="4" Command="{Binding TestPressCommand}" CommandParameter="4" Width="32" Margin="0,0,4,0"/>
            <Button Content="5" Command="{Binding TestPressCommand}" CommandParameter="5" Width="32" Margin="0,0,4,0"/>
            <Button Content="6" Command="{Binding TestPressCommand}" CommandParameter="6" Width="32" Margin="0,0,4,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Раунды:" VerticalAlignment="Center" Width="120"/>
            <Button Content="1" Command="{Binding TestRoundCommand}" CommandParameter="1" Width="32" Margin="0,0,4,0"/>
            <Button Content="2" Command="{Binding TestRoundCommand}" CommandParameter="2" Width="32" Margin="0,0,4,0"/>
            <Button Content="3" Command="{Binding TestRoundCommand}" CommandParameter="3" Width="32" Margin="0,0,4,0"/>
            <Button Content="4" Command="{Binding TestRoundCommand}" CommandParameter="4" Width="32" Margin="0,0,4,0"/>
            <Button Content="5" Command="{Binding TestRoundCommand}" CommandParameter="5" Width="32" Margin="0,0,4,0"/>
            <Button Content="6" Command="{Binding TestRoundCommand}" CommandParameter="6" Width="32" Margin="0,0,4,0"/>
            <Button Content="7" Command="{Binding TestRoundCommand}" CommandParameter="7" Width="32" Margin="0,0,4,0"/>
            <Button Content="8" Command="{Binding TestRoundCommand}" CommandParameter="8" Width="32" Margin="0,0,4,0"/>
            <Button Content="9" Command="{Binding TestRoundCommand}" CommandParameter="9" Width="32" Margin="0,0,4,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
            <TextBlock Text="Очки:" VerticalAlignment="Center" Width="120"/>
            <Button Content="Да"  Command="{Binding TestScoreYesCommand}" Width="60" Margin="0,0,4,0"/>
            <Button Content="Нет" Command="{Binding TestScoreNoCommand}"  Width="60"/>
        </StackPanel>

    </StackPanel>
</UserControl>
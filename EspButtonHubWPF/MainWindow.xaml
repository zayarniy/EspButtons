<Window x:Class="EspButtonDiag.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EspButtonDiag.Wpf.ViewModels"
        Title="ESP8266 Диагностика кнопок"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Цвета по уровню события -->
        <Style TargetType="TextBlock" x:Key="LogText">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ===== Панель управления ===== -->
        <Border DockPanel.Dock="Top" Padding="8" Background="#F0F0F0"
                BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="UDP порт:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox Width="60" Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsRunning, Converter={x:Static vm:BoolInverter.Instance}}"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="ACK порт:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox Width="60" Text="{Binding AckPort, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsRunning, Converter={x:Static vm:BoolInverter.Instance}}"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Таймаут HB (с):" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox Width="50" Text="{Binding HeartbeatTimeoutSec, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsRunning, Converter={x:Static vm:BoolInverter.Instance}}"
                         VerticalContentAlignment="Center"/>

                <Button Content="▶ Запустить" Command="{Binding StartCommand}"
                        Margin="16,0,4,0" Padding="10,4"/>
                <Button Content="■ Остановить" Command="{Binding StopCommand}"
                        Margin="4,0,4,0" Padding="10,4"/>

                <Button Content="Очистить журнал" Command="{Binding ClearLogCommand}"
                        Margin="16,0,4,0" Padding="10,4"/>
                <Button Content="Очистить таблицу" Command="{Binding ClearButtonsCommand}"
                        Margin="4,0,0,0" Padding="10,4"/>
            </StackPanel>
        </Border>

        <!-- ===== Статус-бар ===== -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== Основная область ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Таблица кнопок ===== -->
            <GroupBox Header="Подключённые кнопки" Grid.Column="0" Margin="6">
                <DataGrid ItemsSource="{Binding Buttons}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#FAFAFA">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Alive}" Value="False">
                                    <Setter Property="Foreground" Value="#999"/>
                                    <Setter Property="Background" Value="#FFF3E0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Состояние" Width="70"
                                            Binding="{Binding Alive, Converter={x:Static vm:AliveConverter.Instance}}"/>
                        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="140"/>
                        <DataGridTextColumn Header="IP" Binding="{Binding LastIp}" Width="120"/>
                        <DataGridTextColumn Header="Нажатий" Binding="{Binding PressCount}" Width="70"/>
                        <DataGridTextColumn Header="Посл. seq" Binding="{Binding LastSeq}" Width="80"/>
                        <DataGridTextColumn Header="Uptime, ms" Binding="{Binding LastUptimeMs}" Width="90"/>
                        <DataGridTextColumn Header="Первый раз" Binding="{Binding FirstSeenLocal}" Width="90"/>
                        <DataGridTextColumn Header="Последний раз" Binding="{Binding LastSeenLocal}" Width="100"/>
                        <DataGridTextColumn Header="Тишина, с" Binding="{Binding SecondsSinceLastSeen}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- ===== Журнал ===== -->
            <GroupBox Header="Журнал" Grid.Column="1" Margin="6">
                <ListBox ItemsSource="{Binding Log}"
                         x:Name="LogList"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource LogText}"
                                           Text="{Binding TimeText}"
                                           Foreground="#888" Width="90"/>
                                <TextBlock Style="{StaticResource LogText}"
                                           Text="{Binding KindText}"
                                           Width="80"
                                           Foreground="{Binding Kind, Converter={x:Static vm:KindToBrushConverter.Instance}}"/>
                                <TextBlock Style="{StaticResource LogText}"
                                           Text="{Binding Message}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>